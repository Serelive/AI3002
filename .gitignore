# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging and build output
build/
dist/
*.egg-info/

# IDE and notebook state
.idea/
.vscode/
.ipynb_checkpoints/
/.codex/
/.agents/
/.aws/
*.pem
*.key

# Course materials: retain indexes and placeholders, not originals
/materials/**
!/materials/**/
!/materials/**/.gitkeep
!/materials/README.md

# Shared data: retain metadata and placeholders, not datasets
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/README.md

# Assignment-local immutable inputs and generated output stay local
/assignments/*/data/**
!/assignments/*/data/**/
!/assignments/*/data/**/.gitkeep
!/assignments/*/data/README.md
/assignments/*/prompt/**
!/assignments/*/prompt/**/
!/assignments/*/prompt/**/.gitkeep
!/assignments/*/prompt/README.md
/assignments/*/output/**
!/assignments/*/output/**/
!/assignments/*/output/**/.gitkeep

# Actual nested course layout: supplied inputs and generated files stay local
/assignments/labs/lab1/main/datasets/
/assignments/labs/lab1/backups/
/assignments/labs/lab1/docs/*.pdf
# Reference paper PDFs stay local; track their index and checksums
/assignments/labs/lab1/docs/papers/**/*.pdf
/assignments/homeworks/hw1/docs/*.pdf
/assignments/labs/*/output/
/assignments/labs/*/main/output/
/slurm-*.out
/assignments/homeworks/*/output/
/assignments/labs/lab1/report/*.aux
/assignments/labs/lab1/report/*.fdb_latexmk
/assignments/labs/lab1/report/*.fls
/assignments/labs/lab1/report/*.log
/assignments/labs/lab1/report/*.out
/assignments/labs/lab1/report/*.xdv
/assignments/labs/lab1/report/*.synctex.gz
/assignments/labs/lab1/report/report.template.pdf

# Disposable experiments
/scratch/**
!/scratch/.gitkeep

# OS noise
Thumbs.db
.DS_Store
